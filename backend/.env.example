PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
DATABASE_URL="postgresql://postgres:password@localhost:5432/yahsab_apartments?schema=public"
JWT_SECRET="yahsab-jwt-secret-key-at-least-32-characters"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="yahsab-cookie-secret-key"

# Supabase Auth (BACKEND ONLY — never expose these to the frontend)
# Find URL and API keys in: Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Asymmetric signing: defaults to https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"
# For legacy HS256 projects, use SUPABASE_JWT_SECRET instead of SUPABASE_JWKS_URL.
# SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT=587
BREVO_SMTP_USER="brevo-smtp-login"
BREVO_SMTP_PASSWORD="brevo-smtp-key"
BREVO_FROM="Yahsab Apartments <reservations@yahsab.com>"
EMAIL_FROM="Yahsab Apartments <reservations@yahsab.com>"
ADMIN_EMAIL="admin@yahsab.com"
CLOUDINARY_CLOUD_NAME="yahsab"
CLOUDINARY_API_KEY="1234567890"
CLOUDINARY_API_SECRET="abcdefghijklmnopqrstuvwxyz"
