# Frontend environment variables for Yahsab Luxury Apartments
# Copy to .env.local and fill in your values

# Backend API URL
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"

# Paystack (Test Mode)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Site URL (used for OAuth redirects, email links, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Auth (only the anon/public key — NEVER the service role key)
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
