# ==========================================
# YAHSAB APARTMENTS - ENVIRONMENT TEMPLATE
# ==========================================

# -----------------
# BACKEND (.env)
# -----------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Connection String (Neon, Supabase, or Local Postgres)
# KEEP THIS AS YOUR EXISTING DATABASE. Do NOT point this at Supabase's database.
DATABASE_URL="postgresql://postgres:password@localhost:5432/yahsab_apartments?schema=public"

# Authentication & Security
JWT_SECRET="super-secret-yahsab-jwt-token-minimum-32-chars-long"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="super-secret-cookie-signing-key"

# Supabase Auth (BACKEND ONLY — service role key, never exposed to frontend)
# Find these in: Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Anon key is used for token verification on the backend (optional: can use service role instead)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Paystack Payment Gateway (Test Mode)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Email Notifications (SMTP or Brevo)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT=587
BREVO_SMTP_USER="brevo-smtp-username"
BREVO_SMTP_PASSWORD="brevo-smtp-password"
BREVO_FROM="Yahsab Apartments <reservations@yahsab.com>"
EMAIL_FROM="Yahsab Apartments <reservations@yahsab.com>"
ADMIN_EMAIL="admin@yahsab.com"

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME="yahsab"
CLOUDINARY_API_KEY="1234567890"
CLOUDINARY_API_SECRET="abcdefghijklmnopqrstuvwxyz"

# -----------------
# FRONTEND (.env.local)
# -----------------
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Auth (FRONTEND — only the anon/public key, never the service role key)
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
